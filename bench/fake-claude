#!/usr/bin/env python3
"""A stand-in for `claude -p --bare` in tests (CHALK_CLAUDE=bench/fake-claude): reads the stream-json message,
streams a fixed answer the way Claude Code does (input_json_delta chunks), then the result. No model, no key.
The marks call gets a circle around FAKE_BOX (default 100,100,200,60) and a sentence; the diagram call FAKE_SKETCH
(JSON; default no board)."""
import json, os, sys

args = sys.argv[1:]
schema = json.loads(args[args.index("--json-schema") + 1]) if "--json-schema" in args else {}
msg = json.loads(sys.stdin.readline() or "{}")
with open(os.environ.get("FAKE_LOG", os.devnull), "a") as f:
    f.write(json.dumps({"args": args[:4], "text": [c.get("text", "") for c in msg.get("message", {}).get("content", [])
                                                   if c.get("type") == "text"]}) + "\n")
if "draw" in schema.get("properties", {}):
    answer = json.loads(os.environ.get("FAKE_SKETCH") or '{"draw": false}')
else:
    box = [float(v) for v in os.environ.get("FAKE_BOX", "100,100,200,60").split(",")]
    answer = {"shapes": [{"kind": "circle", "box": box, "label": "this one"}], "say": "That's the button you want."}
text = json.dumps(answer)
for i in range(0, len(text), 24):   # streamed in pieces, like the API
    print(json.dumps({"type": "stream_event", "event": {"delta": {"type": "input_json_delta", "partial_json": text[i:i + 24]}}}), flush=True)
print(json.dumps({"type": "result", "structured_output": answer, "total_cost_usd": 0}), flush=True)
