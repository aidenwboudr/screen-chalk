# ---------- panels: cards the user answers ----------

def cmd_panel(args):
    """Put up a panel (spec: panel.py). With --wait, block until the user answers it, dismisses it, or it goes, and
    print that as JSON. Run over ssh it holds ssh's stdin open (--guard): when the caller stops waiting,
    the panel is taken down too, so nobody answers a question that nothing will read."""
    opt = lambda k, d: float(args[args.index(k) + 1]) if k in args else d
    timeout = opt("--timeout", 0)
    rest = [a for i, a in enumerate(args) if not a.startswith("--") and not (i and args[i - 1] == "--timeout")]
    spec = parse_shapes(rest[0] if rest else None)
    spec = dict(spec[0] if isinstance(spec, list) else spec, kind="panel")
    spec.setdefault("tag", f"panel-{int(time.time() * 1000)}")
    tag = spec["tag"]
    draw([spec], keep=True)
    if "--wait" not in args:
        print(json.dumps({"tag": tag}))
        return
    guard = "--guard" in args
    t0 = time.monotonic()
    while True:
        if guard and select.select([sys.stdin], [], [], 0)[0] and not sys.stdin.buffer.read1(1):
            send({"op": "remove", "tags": [tag]}, start=False)
            return
        r = send({"op": "wait", "tag": tag, "timeout": 1.0}, start=False, timeout=10)
        if r is None:
            r = {"tag": tag, "status": "gone"}   # the overlay went away
        if r.get("status") != "waiting":
            r.pop("ok", None)
            print(json.dumps(r))
            return
        if timeout and time.monotonic() - t0 > timeout:
            send({"op": "remove", "tags": [tag]}, start=False)
            print(json.dumps({"tag": tag, "status": "timeout"}))
            return

