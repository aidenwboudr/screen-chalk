COMMANDS = {"look": cmd_look, "draw": cmd_draw, "ask": cmd_ask, "clear": cmd_clear, "start": cmd_start,
            "status": cmd_status, "stop": cmd_stop, "say": cmd_say, "play": cmd_play, "hush": cmd_hush,
            "watch": cmd_watch, "route": cmd_route, "peek": cmd_peek, "panel": cmd_panel, "focus": cmd_focus,
            "copy": cmd_copy, "toast": cmd_toast, "remove": cmd_remove}


def bring_back(out, argv):
    """A bundle from the screen's machine (look or watch) -> the screenshot saved here + look.json, like a local look."""
    data = json.loads(out)
    os.makedirs(STATE, exist_ok=True)
    data["shot"] = os.path.join(STATE, "shot.png")
    open(data["shot"], "wb").write(base64.b64decode(data.pop("png")))
    json.dump({k: data[k] for k in ("time", "origin", "size", "shot", "elements", "ms") if k in data},
              open(os.path.join(STATE, "look.json"), "w"))
    if "--json" in argv:
        print(json.dumps(data))
    else:
        if "reason" in data:
            print(f"{data['reason']} after {data['waited']} s" + (f", around {data['where']}" if data.get("where") else ""))
        print_look(data)


def forward(argv):
    remote = ["ssh", "-o", "ConnectTimeout=10", REMOTE]
    cmd = argv[0] if argv else ""
    if cmd == "look":
        flags = " --ocr" if "--ocr" in argv else ""
        r = subprocess.run(remote + [f"{RBIN} look --bundle" + flags], capture_output=True)
        sys.stderr.write(r.stderr.decode(errors="replace"))
        if r.returncode:
            sys.exit(r.returncode)
        return bring_back(r.stdout, argv)
    if cmd == "watch":
        # stdin stays open: when this process is killed (the caller stopped waiting), ssh closes it and the
        # screen side notices and quits instead of grabbing frames for minutes
        rest = [a for a in argv[1:] if a not in ("--json", "--bundle", "--guard")]
        # (not communicate(): it would close stdin at once, which reads as giving up)
        p = subprocess.Popen(remote + [RBIN + " " + shlex.join(["watch", "--bundle", "--guard", *rest])],
                             stdin=subprocess.PIPE, stdout=subprocess.PIPE)
        out = p.stdout.read()
        p.wait()
        if p.returncode or not out.strip():
            sys.exit(p.returncode or 1)
        return bring_back(out, argv)
    if cmd == "panel":
        rest = [a for a in argv[1:] if a not in ("--guard", "-")]
        if not any(not a.startswith("--") and not (i and rest[i - 1] == "--timeout") for i, a in enumerate(rest)):
            rest.insert(0, sys.stdin.read())          # the spec came on stdin: ssh's stdin is the guard
        if "--wait" not in rest:
            sys.exit(subprocess.run(remote + [RBIN + " " + shlex.join(["panel", *rest])]).returncode)
        p = subprocess.Popen(remote + [RBIN + " " + shlex.join(["panel", "--guard", *rest])],
                             stdin=subprocess.PIPE, stdout=subprocess.PIPE)
        out = p.stdout.read()
        p.wait()
        sys.stdout.write(out.decode(errors="replace"))
        sys.exit(p.returncode)
    if cmd == "say":
        if "--pcm" in argv:  # the screen's machine asking for audio
            sys.exit(say_here(argv[1:], None))
        if not chalkconf.words("CHALK_VOICE_CMD"):   # no voice here: the screen's machine speaks (or toasts) itself
            sys.exit(subprocess.run(remote + [RBIN + " " + shlex.join(argv)]).returncode)
        sys.exit(say_here(argv[1:], remote + [f"{RBIN} play"]))
    if cmd == "draw":
        rest = [a for a in argv[1:] if a != "--keep"]
        payload = sys.stdin.read() if not rest or rest[0] == "-" else rest[0]
        flags = ["--keep"] if "--keep" in argv else []
        r = subprocess.run(remote + [RBIN + " " + shlex.join(["draw", "-", *flags])], input=payload.encode())
        sys.exit(r.returncode)
    sys.exit(subprocess.run(remote + [RBIN + " " + shlex.join(argv)]).returncode)


def main():
    global ENV
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help") or argv[0] not in COMMANDS:
        print(__doc__.strip()); sys.exit(0 if argv and argv[0] in ("-h", "--help", "help") else 1)
    os.umask(0o077)   # screenshots, the look and ask.log are this user's alone
    ENV = find_session()
    if ENV is None:
        if argv[0] == "say" and "--pcm" in argv:   # serving speech to another machine needs no screen
            sys.exit(say_here(argv[1:], None))
        if os.environ.get("CHALK_NO_FORWARD") or not REMOTE:
            die("no Sway session found on this machine" + ("" if os.environ.get("CHALK_NO_FORWARD") else
                " (to draw on another machine's screen over ssh, set CHALK_HOST)"))
        return forward(argv)
    os.makedirs(STATE, exist_ok=True)
    COMMANDS[argv[0]](argv[1:])


if __name__ == "__main__":
    main()
